/target
**/target

# Frontend
/ui/node_modules
/ui/dist
/ui/.vite

# Tauri generated mobile projects
/crates/app-tauri/gen/android
/crates/app-tauri/gen/apple

# NEVER commit a database — these contain real financial data.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Exports may contain real financial data.
*.xlsx
*.csv

# …except the bundled rate table, which is published reference data and holds
# nothing personal. It is `include_str!`d, so leaving it ignored does not fail
# quietly — it fails the *build*, and only for someone whose checkout is clean.
# The author's working copy still has the file on disk and compiles fine.
!/crates/accounting-core/src/rates/*.csv

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Regenerated by tauri-build on every build from tauri.conf.json and
# capabilities/. Checking it in means reviewing a machine-written diff each
# time the config changes.
/crates/accounting-tauri/gen/schemas/
