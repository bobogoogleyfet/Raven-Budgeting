/target
**/target

# The web build's Rust half, written by scripts/build-web-bridge.sh. Build
# output like `target/`, and 2.7MB of it that changes with every edit to the
# core.
/app/web/pkg/

# NEVER commit a database — these contain real financial data.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Exports may contain real financial data.
*.xlsx
*.csv

# …except the bundled rate table, which is published reference data and holds
# nothing personal. It is `include_str!`d, so leaving it ignored does not fail
# quietly — it fails the *build*, and only for someone whose checkout is clean.
# The author's working copy still has the file on disk and compiles fine.
!/crates/accounting-core/src/rates/*.csv

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Worktrees live inside the repo, and `git add -A` will otherwise commit one
# as a submodule gitlink — which clones as an empty directory and makes
# `git submodule status` fail on a mapping that was never intended to exist.
/.claude/worktrees/
