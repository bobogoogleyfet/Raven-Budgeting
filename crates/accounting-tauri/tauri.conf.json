{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accounting",
  "version": "0.1.0",
  "identifier": "com.tannerhathaway.accounting",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Accounting",
        "width": 1000,
        "height": 700,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
